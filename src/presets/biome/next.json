{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "files": { "includes": ["**/*.{ts,tsx,mts,cts}"] },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "useImportType": "error", "noHeadElement": "error" },
      "suspicious": { "noExplicitAny": "warn", "noDocumentImportInPage": "error" },
      "performance": { "noImgElement": "error" },
      "correctness": { "useHookAtTopLevel": "error", "useJsxKeyInIterable": "error", "noUnknownProperty": "error" }
    },
    "domains": { "react": "recommended", "next": "recommended" }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120,
    "attributePosition": "auto",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "expand": "never",
    "useEditorconfig": true,
    "includes": [
      "**",
      "!**/.bun/",
      "!**/.pnp/",
      "!**/.pnp.*",
      "!**/.pnpm-store/",
      "!**/node_modules/",
      "!**/vendor/",
      "!**/.next/",
      "!**/out/",
      "!**/.svelte-kit/",
      "!**/build/",
      "!**/dist/",
      "!**/.cache/",
      "!**/.eslintcache",
      "!**/.gulp/",
      "!**/.parcel-cache/",
      "!**/.rollup.cache/",
      "!**/.stylelintcache",
      "!**/.turbo/",
      "!**/.vite/",
      "!**/.vitest/",
      "!**/.webpack/",
      "!**/.jest/",
      "!**/.nyc_output/",
      "!**/blob-report/",
      "!**/coverage/",
      "!**/playwright-report/",
      "!**/test-results/",
      "!**/vitest-results/",
      "!**/.tmp/",
      "!**/tmp/",
      "!**/.idea/",
      "!**/.vscode-insiders/",
      "!**/.netlify/",
      "!**/.vercel/",
      "!**/.wrangler/",
      "!**/assets/",
      "!**/public/",
      "!**/static/",
      "!**/.agent",
      "!**/.agents",
      "!**/.aider",
      "!**/.amazonq",
      "!**/.antigravitycli",
      "!**/.augmith",
      "!**/.bolt",
      "!**/.charliepython",
      "!**/.claude",
      "!**/.cline",
      "!**/.codex",
      "!**/.continue",
      "!**/.copilot",
      "!**/.crush",
      "!**/.cursor",
      "!**/.devin",
      "!**/.fallow",
      "!**/.freebuff",
      "!**/.gemini",
      "!**/.gptscript",
      "!**/.jina",
      "!**/.kilo",
      "!**/.kilocode",
      "!**/.maestro",
      "!**/.manus",
      "!**/.midjourney",
      "!**/.mistral",
      "!**/.nexus",
      "!**/.opencode",
      "!**/.perplexity",
      "!**/.qoder",
      "!**/.qwen",
      "!**/.replit",
      "!**/.starcode",
      "!**/.supercursor",
      "!**/.vibe",
      "!**/.windsurf",
      "!**/.xai",
      "!**/.env",
      "!**/.env.*",
      "!**/*.pem",
      "!**/bun.lock",
      "!**/composer.lock",
      "!**/package-lock.json",
      "!**/pnpm-lock.yaml",
      "!**/yarn.lock",
      "!**/*.tsbuildinfo",
      "!**/next-env.d.ts",
      "!**/._circleci/",
      "!**/.gitlab/",
      "!**/.gitlab-ci.yml",
      "!**/azure-pipelines.yml",
      "!**/bitbucket-pipelines.yml",
      "!**/docker-compose.yaml",
      "!**/docker-compose.yml",
      "!**/*.kubeconfig",
      "!**/*.min.css",
      "!**/*.min.js",
      "!**/*.min.map",
      "!**/*.log",
      "!**/npm-debug.log*",
      "!**/pnpm-debug.log*",
      "!**/yarn-debug.log*",
      "!**/yarn-error.log*"
    ]
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "es5",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "quoteStyle": "double",
      "attributePosition": "auto",
      "bracketSpacing": true
    }
  },
  "html": { "formatter": { "indentScriptAndStyle": false, "selfCloseVoidElements": "always" } },
  "overrides": [
    { "includes": ["**/*.py", "**/*.php"], "formatter": { "indentStyle": "space", "indentWidth": 4 } },
    {
      "includes": ["**/*.js", "**/*.ts", "**/*.mjs", "**/*.cjs", "**/*.jsx", "**/*.tsx"],
      "javascript": { "formatter": { "quoteStyle": "single" } },
      "formatter": { "indentWidth": 2 }
    },
    { "includes": ["**/*.css", "**/*.scss", "**/*.sass"], "formatter": { "indentWidth": 2 } },
    {
      "includes": ["**/*.json", "**/*.jsonc", "**/*.yml", "**/*.yaml", "**/*.md", "**/*.mdx"],
      "javascript": { "formatter": { "trailingCommas": "none" } },
      "formatter": { "indentWidth": 2 }
    },
    { "includes": ["**/*.yml", "**/*.yaml"], "formatter": { "indentWidth": 2 } },
    { "includes": ["**/*.xml", "**/*.xsd", "**/*.xsl", "**/*.xslt"], "formatter": { "indentWidth": 2 } }
  ]
}
